#!/bin/bash
# -----------------------------------------------------------------------------
# @file bash-local
#
# @brief This script implements bash-local.
# @description bash-local is a way to maintain a unique environment
# (aliases, functions, and variables) for each directory.
# It coexists with the usual Bash environment.
# -----------------------------------------------------------------------------

# MARK: New session
_BL_STATE[TMP_DIR]="$(mktemp -d "/tmp/bl.$UID.$BASHPID.XXXXXX")"
_BL_STATE[PREVIOUS_ENVIRONMENTS_FILE]="${_BL_STATE[TMP_DIR]}/environments.alpha"
_BL_STATE[CURRENT_ENVIRONMENTS_FILE]="${_BL_STATE[TMP_DIR]}/environments.beta"
: > "${_BL_STATE[PREVIOUS_ENVIRONMENTS_FILE]}"
: > "${_BL_STATE[CURRENT_ENVIRONMENTS_FILE]}"
trap 'rm -rf "${_BL_STATE[TMP_DIR]}"' EXIT SIGHUP