unloadEnv() {

    local -r env_=$1
    local -a aliases functions variables

    getEnv "$env_" aliases functions variables #ToDo
    unsourceEnv aliases functions variables #ToDo

    return 0
}

unloadEnvs() {

    local -rn OLD_ENVS=$1
    
    for env_ in "${OLD_ENVS[@]}"; do
        unloadEnv $env_
    done
    
    return 0
}

unload() {
    
    cat "$CURRENT_ENV_LIST" > "$PREVIOUS_ENV_LIST" ## Pass these variables as parameters (it will be also used in load stage?)
    
    resetCurrentEnvList "$CURRENT_ENV_LIST" #ToDo
    
    # Both files (ENV_LIST) OK up to this point
    
    local -a old_envs
    # Get those envs in $PREVIOUS_ENV_LIST not present in $CURRENT_ENV_LIST
    mapfile -t old_envs < <(diff "$PREVIOUS_ENV_LIST" "$CURRENT_ENV_LIST" 2>/dev/null | grep '^< ')
    
    unloadEnvs old_envs

    return 0
}

_bl_set_environment_files() {

    local -r PPD="$1"

    # Swap files. 'BL_PREVIOUS_ENVIRONMENTS' is set to 'BL_CURRENT_ENVIRONMENTS'
    # in order to avoid external functions ('cp' or 'cat') and increase
    # efficiency.
    local -r AUX="$BL_PREVIOUS_ENVIRONMENTS"
    BL_PREVIOUS_ENVIRONMENTS="$BL_CURRENT_ENVIRONMENTS"
    BL_CURRENT_ENVIRONMENTS="$AUX"

    # Update current environments
    : > "$BL_CURRENT_ENVIRONMENTS"
    if [[ $PWD == "$HOME"* ]]; then

        local dir=$PWD
        while [[ $dir != "$HOME" ]]; do

            [[ -d "$dir/.bl" ]] && printf '%s\n' "$dir" >> "$BL_CURRENT_ENVIRONMENTS"
            # Remove the last segment of 'dir' (e.g. remove '/segment' from
            # '$HOME/segment')
            dir=${dir%/*}
        done
    fi
    return 0
}

_bl_() {

    local -r PPD=$1
    
    _bl_set_environment_files "$PPD"

    #[[ $PPD == $HOME* ]] && _bl_unload
    #[[ $PWD == $HOME* ]] && _bl_load
    
    return 0
}

# MARK: 'cd' hook
cd() {
    
    local -r PPD="$PWD" # Path Previous Directory

    builtin cd "$@" || return
    _bl_ "$PPD"
    
    return 0
}

# MARK: New session
BL_TMP_DIR="$(mktemp -d "/tmp/bl.$UID.$BASHPID.XXXXXX")"
BL_PREVIOUS_ENVIRONMENTS="$BL_TMP_DIR/environments.alpha"
BL_CURRENT_ENVIRONMENTS="$BL_TMP_DIR/environments.beta"
: > "$BL_PREVIOUS_ENVIRONMENTS"
: > "$BL_CURRENT_ENVIRONMENTS"
trap 'rm -rf "$BL_TMP_DIR"' EXIT SIGHUP