#!/user/bin/env bash
# -----------------------------------------------------------------------------
# @file bash-local
#
# @brief This script acts as an entry-point for bash-local.
# @description It is sourced when a new terminal session starts. Sources the
# the context definition and shared modules (shared.bash), the internal core API
# (core.bash) and the CLI (cli.bash).

source "$(dirname "${BASH_SOURCE[0]}")/lib/shared/shared.bash"
source "$(dirname "${BASH_SOURCE[0]}")/lib/core.bash"
source "$(dirname "${BASH_SOURCE[0]}")/lib/cli.bash"


# @description Starts bash-local modules: configuration setup and logging
# initialization.
#
# This function is executed on every terminal session start.
#
# @noargs
bl_start() {

    bl_config_load || return 1
    bl_log_init || return 1
}
bl_start