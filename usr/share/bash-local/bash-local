#!/user/bin/env bash
# -----------------------------------------------------------------------------
# @file bash-local
#
# @brief This script acts as an entry-point for bash-local.
# @description It is sourced when a new terminal session starts. Sources the
# `cd` hook and the CLI, as well as the internal core API and the context
# definition.

# Source files
source "$(dirname "${BASH_SOURCE[0]}")/lib/shared.bash"
source "$(dirname "${BASH_SOURCE[0]}")/lib/core.bash"
source "$(dirname "${BASH_SOURCE[0]}")/lib/hook.bash"
source "$(dirname "${BASH_SOURCE[0]}")/lib/cli.bash"